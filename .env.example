# ===== LLM（OpenAI 兼容接口，换供应商只需改 base_url / model）=====
LLM_API_KEY=sk-your-chat-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== Embedding =====
# EMBEDDING_PROVIDER 三选一：
#   openai（默认）走真实 OpenAI 兼容 embedding 网关；
#   local  用 sentence-transformers 本地推理（如 bge-large-zh-v1.5），
#          首次运行需能访问 huggingface.co 下载 ~1GB 权重，之后离线可用；
#   fake   用 WordHashEmbedder（确定性哈希投影），仅在无 embedding 凭证 / 无网环境下
#          用于贯通管线 / 演示 / CI，**不验证语义检索有效性**——生产/评测不要打开。
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-your-embedding-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024

# ===== 分块 =====
MAX_CHUNK_CHARS=500
FIXED_CHUNK_SIZE=400
FIXED_CHUNK_OVERLAP=80

# ===== 检索 =====
VECTOR_TOP_K=20
BM25_TOP_K=20
RRF_K=60
FINAL_TOP_K=5

# ===== 拒答门控（修订 1：用原始 cosine；阈值先用 0.35 占位，正式按评测集校准） =====
# 注意：该阈值与 embedding 模型强相关，跨模型迁移时必须重新校准（P1）
COSINE_THRESHOLD=0.35
BM25_STRONG_MATCH=true

# ===== 注入防护（修订 2：融合前列内降权）=====
INJECTION_MAX_PENALIZED=3
# P1 消融开关：false 时跳过列内降权（用于 E4 对比实验），默认 true
INJECTION_PENALTY=true

# ===== 存储 =====
DOCS_DIR=docs
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=mini_rag
